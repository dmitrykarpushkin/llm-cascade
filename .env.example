# Stage 0: cheap classifier (TypeSafe System One compatible). Without a key the stage is skipped.
CASCADE_CLASSIFIER_API_KEY=
CASCADE_CLASSIFIER_URL=https://api.typesafe.ai/v1/systemone
CASCADE_CLASSIFIER_MODEL=jev-latest
# Confidence in "noise" needed to drop an item at stage 0
CASCADE_DROP_CONFIDENCE=0.5
# Stages 1 and 2 run through `claude -p` (Claude Code headless, its own login)
CASCADE_FILTER_MODEL=haiku
CASCADE_WRITER_MODEL=opus
# Minimum filter score (1-5) for an item to reach the writer
CASCADE_MIN_SCORE=3
